# Copy to .env and edit. Never commit .env.
PORT=8080

# Where the SQLite file lives.
DB_PATH=./data/desk.db

# Base URL used when printing annotator links. No trailing slash.
# Docker on local machine: http://localhost:8080
# Behind TLS: https://desk.example.ac.uk
PUBLIC_URL=https://desk.example.ac.uk

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Set to 1 only when serving over plain HTTP in local development.
# Leave unset in production so cookies are marked Secure.
INSECURE_COOKIES=

# Compose publishes 127.0.0.1:8080 by default. Uncomment to bind every
# interface on the Docker host (needed if you hit the VM IP directly).
# DESK_BIND=0.0.0.0
# Host port if 8080 is already taken.
# DESK_PORT=8081

# npm script to create owner url: 
# npm run people -- add "Galahad" owner