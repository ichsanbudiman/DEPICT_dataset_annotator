  },
  "Vector Draw 1.2/src/com/vectordraw/shape/LegacyShapeAdapter.java#window": {
   "path": "Vector Draw 1.2/src/com/vectordraw/shape/LegacyShapeAdapter.java",
   "from": 1,
   "to": 22,
   "text": "package com.vectordraw.shape;\n\n/** Presents a legacy primitive through the editor's Figure interface. */\npublic class LegacyShapeAdapter implements Figure {\n\n    private final NativeShape shape;\n\n    private String cachedName = \"\";\n\n    public LegacyShapeAdapter(NativeShape shape) {\n        this.shape = shape;\n    }\n\n    public Bounds displayBox() {\n        return shape.bounds();\n    }\n\n    public String getName() {\n        return cachedName;\n    }\n}\n"
  },
  "Vector Draw 1.2/src/com/vectordraw/shape/NativeShape.java#window": {
   "path": "Vector Draw 1.2/src/com/vectordraw/shape/NativeShape.java",
   "from": 1,
   "to": 12,
   "text": "package com.vectordraw.shape;\n\n/** The legacy primitive. Predates Figure and cannot be changed. */\npublic class NativeShape {\n\n    private int x, y, w, h;\n\n    public Bounds bounds() {\n        return new Bounds(x, y, w, h);\n    }\n}\n"
  }
